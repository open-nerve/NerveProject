{
  "name": "@nerve/utils",
  "version": "1.4.2",
  "private": true,
  "description": "Helper functions shared across multiple apps internally",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "check:lint": "node ../../../tools/lint-cap.mjs 19",
    "check:types": "tsc --noEmit",
    "check:format": "oxfmt --check .",
    "fix:format": "oxfmt .",
    "test": "vitest run"
  },
  "dependencies": {
    "@makeplane/propel": "catalog:",
    "@nerve/constants": "workspace:*",
    "@nerve/types": "workspace:*",
    "clsx": "catalog:",
    "date-fns": "catalog:",
    "hast": "catalog:",
    "hast-util-to-mdast": "catalog:",
    "lodash-es": "catalog:",
    "lucide-react": "catalog:",
    "mdast": "catalog:",
    "react": "catalog:",
    "rehype-parse": "catalog:",
    "rehype-remark": "catalog:",
    "remark-gfm": "catalog:",
    "remark-stringify": "catalog:",
    "tailwind-merge": "catalog:",
    "unified": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@nerve/typescript-config": "workspace:*",
    "@types/hast": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "jsdom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
