{
  "name": "@nerve/e2e",
  "private": true,
  "description": "End-to-end user stories: Playwright against the built bin/nerve and PostgreSQL",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "test:m4-list": "playwright test --config=playwright.m4-list.config.ts",
    "check:types": "tsc --noEmit",
    "check:lint": "node ../tools/lint-cap.mjs 0",
    "check:format": "oxfmt --check .",
    "fix:format": "oxfmt .",
    "test:m4-filters": "playwright test --config=playwright.m4-filters.config.ts",
    "test:m4-detail": "playwright test --config=playwright.m4-detail.config.ts",
    "test:m4-collaboration": "playwright test --config=playwright.m4-collaboration.config.ts",
    "test:m5-s3": "playwright test --config=playwright.m5-s3.config.ts",
    "test:m5-profile": "playwright test --config=playwright.m5-profile.config.ts",
    "test:m5-content": "playwright test --config=playwright.m5-content.config.ts",
    "test:m4-cleanup": "playwright test --config=playwright.m4-cleanup.config.ts"
  },
  "devDependencies": {
    "@nerve/api-client": "workspace:*",
    "@playwright/test": "1.63.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "pg": "8.23.0",
    "testcontainers": "12.1.0",
    "typescript": "catalog:"
  }
}
