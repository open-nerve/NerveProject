{
  "name": "@nerve/shared-state",
  "version": "1.4.2",
  "private": true,
  "description": "Shared state shared across multiple apps internally",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "check:lint": "node ../../../tools/lint-cap.mjs 0",
    "check:types": "tsc --noEmit",
    "check:format": "oxfmt --check .",
    "fix:format": "oxfmt ."
  },
  "dependencies": {
    "@nerve/constants": "workspace:*",
    "@nerve/types": "workspace:*",
    "@nerve/utils": "workspace:*",
    "lodash-es": "catalog:",
    "mobx": "catalog:",
    "mobx-utils": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@nerve/typescript-config": "workspace:*",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
