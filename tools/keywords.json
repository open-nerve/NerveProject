          "  fetchActiveCycleProgressPro: (workspaceSlug: string, projectId: string, cycleId: string) => Promise<void>;",
          "  async workspaceActiveCycles("
        ],
        "miss": [
          "export const ActiveCycleRoot = observer(function ActiveCycleRoot(props: Props) {",
          "  \"active_cycle\": {",
          "export type ActiveCycleProgressProps = {",
          "  const { fetchActiveCycleProgress, getCycleById, fetchActiveCycleDistribution } = useCycle();"
        ],
        "files": {
          "hit": ["web/apps/web/core/services/cycle.service.ts", "web/packages/i18n/src/locales/en/common.json"],
          "miss": ["web/apps/web/app/assets/logo.svg", "docs/v0/M1-frontend-trim/M1-design.md"]
        }
      }
    },
    {
      "id": "profile-stats",
      "phase": "M1/P2",
      "why": "个人主页的统计页、动态页和每个项目的统计数字（Plane 的 /user-stats/、/user-profile/、/user-activity/）；个人主页只剩三个工作项标签和读工作区成员 store 的用户卡片（M1 设计 3.2）",
      "files": { "source": "^web/.*\\.(?:[cm]?[jt]sx?|json)$", "flags": "" },
      "content": {
