        "web/apps/web/core/hooks/use-workspaces-fetch.ts",
        "web/apps/web/core/components/settings/profile/sidebar/workspace-options.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "swr",
                "allowTypeImports": true,
                "message": "A fetch of the session goes through useSessionSWR, whose key carries the loginId (v0 design 7.7)."
              }
            ],
            "patterns": [
              {
                "group": ["swr/*"],
                "allowTypeImports": true,
                "message": "A fetch of the session goes through useSessionSWR, whose key carries the loginId (v0 design 7.7)."
              }
            ]
          }
        ]
      }
