{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOwnedBucketStatus",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketVersioning"],
      "Resource": "arn:aws:s3:::nerve-private-example"
    },
    {
      "Sid": "OwnInstanceObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::nerve-private-example/instance-a/*"
    }
  ]
}
