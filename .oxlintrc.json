{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "jsx-a11y", "import", "promise", "unicorn", "oxc"],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "settings": {
    "react": {
      "version": "19.0"
    },
    "jsx-a11y": {
      "polymorphicPropName": "as"
    }
  },
  "ignorePatterns": [
    ".cache/**",
    ".react-router/**",
    ".turbo/**",
    ".vite/**",
    "*.config.{js,mjs,cjs,ts}",
    "build/**",
    "coverage/**",
    "dist/**",
    "**/public/**",
    "web/packages/api-client/src/schema.gen.ts"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/prop-types": "off",
    "react/jsx-curly-brace-presence": "error",
    "unicorn/filename-case": "off",
    "unicorn/no-null": "off",
    "unicorn/prevent-abbreviations": "off",
    "no-restricted-globals": [
      "error",
      "addEventListener",
      "blur",
      "close",
      "closed",
      "confirm",
      "defaultStatus",
      "defaultstatus",
      "event",
      "external",
      "find",
      "focus",
      "frameElement",
      "frames",
      "history",
      "innerHeight",
      "innerWidth",
      "length",
      "location",
      "locationbar",
      "menubar",
      "moveBy",
      "moveTo",
      "name",
      "onblur",
      "onerror",
      "onfocus",
      "onload",
      "onresize",
      "onunload",
      "open",
      "opener",
      "opera",
      "outerHeight",
      "outerWidth",
      "pageXOffset",
      "pageYOffset",
      "parent",
      "print",
      "removeEventListener",
      "resizeBy",
      "resizeTo",
      "screen",
      "screenLeft",
      "screenTop",
      "screenX",
      "screenY",
      "scroll",
      "scrollbars",
      "scrollBy",
      "scrollTo",
      "scrollX",
      "scrollY",
      "self",
      "status",
      "statusbar",
      "stop",
      "toolbar",
      "top"
    ],
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "web/apps/web/core/store/workspace/**",
        "web/apps/web/core/store/member/workspace/**",
        "web/apps/web/core/store/member/project/**",
        "web/apps/web/core/components/workspace/settings/**",
        "web/apps/web/core/components/profile/use-profile-member.ts",
        "web/apps/web/core/layouts/auth-layout/use-workspace-fetch.ts",
        "web/apps/web/core/components/projects/use-archived-projects-fetch.ts",
        "web/apps/web/core/lib/use-landing.ts",
        "web/apps/web/core/lib/wrappers/authentication-wrapper.tsx",
        "web/apps/web/app/(all)/workspace-invitations/page.tsx",
        "web/apps/web/core/components/account/auth-forms/auth-header.tsx",
        "web/apps/web/core/components/api-token/token-list.tsx",
        "web/apps/web/core/hooks/use-workspace-members-fetch.ts",
        "web/apps/web/core/store/project/**",
        "web/apps/web/core/components/projects/page.tsx",
        "web/apps/web/core/store/state.store.ts",
        "web/apps/web/core/components/project-states/**",
        "web/apps/web/core/layouts/auth-layout/workspace-wrapper.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "swr",
                "allowTypeImports": true,
                "message": "A fetch of the session goes through useSessionSWR, whose key carries the loginId (v0 design 7.7)."
              }
            ],
            "patterns": [
              {
                "group": ["swr/*"],
                "allowTypeImports": true,
                "message": "A fetch of the session goes through useSessionSWR, whose key carries the loginId (v0 design 7.7)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "web/apps/web/core/store/workspace/**",
        "web/apps/web/core/store/member/workspace/**",
        "web/apps/web/core/store/member/project/**",
        "web/apps/web/core/store/user/permissions.store.ts",
        "web/apps/web/core/store/user/permissions.store.test.ts",
        "web/apps/web/core/services/workspace/**",
        "web/apps/web/core/components/workspace/settings/**",
        "web/apps/web/core/components/profile/use-profile-member.ts",
        "web/apps/web/core/layouts/auth-layout/use-workspace-fetch.ts",
        "web/apps/web/core/layouts/auth-layout/use-workspace-fetch.test.ts",
        "web/apps/web/core/lib/error-messages.test.ts",
        "web/apps/web/core/lib/error-messages.ts",
        "web/apps/web/core/lib/fake-session-swr.ts",
        "web/apps/web/core/lib/in-session.test.ts",
        "web/apps/web/core/lib/in-session.ts",
        "web/apps/web/core/lib/landing.test.ts",
        "web/apps/web/core/lib/landing.ts",
        "web/apps/web/core/lib/session-key.test.ts",
        "web/apps/web/core/lib/session-key.ts",
        "web/apps/web/core/lib/use-landing.test.ts",
        "web/apps/web/core/lib/use-landing.ts",
        "web/apps/web/core/lib/use-session-swr.test.ts",
        "web/apps/web/core/lib/use-session-swr.ts",
        "web/apps/web/core/lib/wrappers/authentication-wrapper.tsx",
        "web/apps/web/core/lib/reconciled.ts",
        "web/apps/web/core/store/fake-root.ts",
        "web/apps/web/core/store/fake-queue.ts",
        "web/apps/web/core/hooks/navigation-preferences.ts",
        "web/apps/web/core/hooks/navigation-preferences.test.ts",
        "web/apps/web/core/hooks/use-navigation-preferences.ts",
        "web/apps/web/core/hooks/use-invitation-preview.ts",
        "web/apps/web/core/hooks/use-invitation-preview.test.ts",
        "web/apps/web/core/hooks/use-workspace-members-fetch.ts",
        "web/apps/web/core/hooks/use-workspace-members-fetch.test.ts",
        "web/apps/web/core/hooks/store/fake-store-hooks.ts",
        "web/apps/web/core/components/profile/use-profile-member.test.ts",
        "web/apps/web/core/services/project/projects.service.ts",
        "web/apps/web/core/services/project/project-preferences.service.ts",
        "web/apps/web/core/services/project/project-members.service.ts",
        "web/apps/web/core/services/project/states.service.ts",
        "web/apps/web/core/store/state.store.ts",
        "web/apps/web/core/store/state.store.test.ts",
        "web/apps/web/core/store/state.store.changes.test.ts",
        "web/apps/web/core/components/project-states/create-update/create-update.test.tsx",
        "web/apps/web/core/store/project/**",
        "web/apps/web/core/hooks/store/use-project-preferences.ts",
        "web/apps/web/core/components/navigation/use-tab-preferences.ts",
        "web/apps/web/core/components/navigation/tab-navigation-utils.ts",
        "web/apps/web/core/components/navigation/tab-navigation-utils.test.ts",
        "web/apps/web/core/lib/place-between.ts",
        "web/apps/web/core/components/projects/use-archived-projects-fetch.ts",
        "web/apps/web/core/components/projects/use-archived-projects-fetch.test.ts",
        "web/apps/web/core/components/projects/page.tsx"
      ],
      "rules": {
        "typescript/no-non-null-assertion": "error"
      }
    }
  ]
}
