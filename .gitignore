# 参考代码（只读，不进仓库）
refer/
plane/

# 系统与编辑器
.DS_Store
.idea/
.vscode/

# 本地环境变量
.env
.env.*

# 个人本地配置覆盖（见 docs/v0/v0-design.md 6.8）
config.local.yaml

# Claude Code 的隔离工作区
.claude/worktrees/

# 构建与依赖产物
bin/
node_modules/
.turbo/
coverage/
*.test
*.out

# 前端的生成物和构建产物
web/apps/web/.react-router/
web/apps/web/build/
web/packages/*/dist/

# 内嵌的前端：只提交 .gitkeep，其余由 make build 复制进来
server/internal/platform/webui/dist/*
!server/internal/platform/webui/dist/.gitkeep
