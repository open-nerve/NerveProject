          "    \"your_work_by_priority\": {"
        ],
        "miss": [
          "import { PROFILE_TABS } from \"@plane/constants\";",
          "    i18n_label: \"profile.tabs.assigned\",",
          "import UserActivityIcon from \"./user-activity-icon\";",
          "      `/api/workspaces/${workspaceSlug}/user-issues/${userId}/`,",
          "  const { data: members, isLoading } = useSWR("
        ],
        "files": {
          "hit": ["web/apps/web/core/services/user.service.ts", "web/packages/i18n/src/locales/en/empty-state.json"],
          "miss": ["web/apps/web/app/assets/logo.svg", "docs/v0/M1-frontend-trim/M1-design.md"]
        }
      }
    }
  ],
  "exceptions": [
    {
      "rule": "analytics",
      "path": "web/packages/utils/src/tlds.ts",
      "match": "analytics",
      "reason": "tlds.ts 是 url.ts 识别链接用的顶级域名列表，.analytics 是一个真实的顶级域名，不是功能代码；列表必须完整，这一项在 v0 内不可能消失",
      "until": "M9"
    },
    {
      "rule": "analytics",
      "path": "web/apps/web/core/services/cycle.service.ts",
      "match": "analytics",
      "reason": "Plane 的迭代进度接口地址 /cycles/{id}/analytics?type= 本身带 analytics；M1 不改接口，M6 换成新接口时删除（M1 设计 3.4）",
      "until": "M6"
    },
    {
      "rule": "analytics",
      "path": "web/apps/web/core/components/workspace/billing/comparison/plans.tsx",
      "match": "analytics",
      "reason": "计费对比表的营销文案，随计费在 M1/P3 删除",
      "until": "M1/P3"
    },
    {
      "rule": "analytics",
      "path": "web/apps/web/core/components/workspace/billing/comparison/plans.tsx",
      "match": "Analytics",
      "count": 3,
      "reason": "计费对比表的营销文案，随计费在 M1/P3 删除",
      "until": "M1/P3"
    },
    {
      "rule": "analytics",
      "path": "web/packages/types/src/epics.ts",
      "match": "Analytics",
      "count": 2,
      "reason": "TEpicAnalyticsGroup、TEpicAnalytics 是 Epic 的企业版类型，随 Epic 在 M1/P3 删除",
      "until": "M1/P3"
    }
  ]
}
