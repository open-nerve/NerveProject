{
  "name": "@nerve/services",
  "version": "1.4.2",
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "check:lint": "node ../../../tools/lint-cap.mjs 0",
    "check:types": "tsc --noEmit",
    "check:format": "oxfmt --check .",
    "fix:format": "oxfmt .",
    "test": "vitest run"
  },
  "dependencies": {
    "@nerve/constants": "workspace:*",
    "@nerve/types": "workspace:*",
    "axios": "catalog:",
    "file-type": "catalog:"
  },
  "devDependencies": {
    "@nerve/typescript-config": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
